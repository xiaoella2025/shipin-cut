node_modules/
dist/
.DS_Store

# 用户输入视频（不提交）
input-videos/*
!input-videos/.gitkeep

# 本地工具输出（不提交）
local-output/audio/*
!local-output/audio/.gitkeep
local-output/thumbs/*
!local-output/thumbs/.gitkeep
local-output/analysis/*
!local-output/analysis/.gitkeep
local-output/subtitles/*
!local-output/subtitles/.gitkeep

# whisper.cpp 工具和模型（不提交）
tools/*
!tools/.gitkeep
!tools/export_video.py
!tools/local_export_server.py
!tools/jianying_draft/
tools/jianying_draft/__pycache__/
tests/__pycache__/
__pycache__/
*.pyc
sample_drafts/

# export_workspace 中的实际媒体文件不提交，只保留目录结构
export_workspace/videos/*
!export_workspace/videos/.gitkeep
export_workspace/audio/*
!export_workspace/audio/.gitkeep
export_workspace/output/*
!export_workspace/output/.gitkeep
export_workspace/temp/*
!export_workspace/temp/.gitkeep
export_workspace/drafts/*.json
export_workspace/drafts/
.claude/
